# Python services — Phase 2
# Copied from app/.env so both halves of the platform share one database and asset store.

# --- MongoDB -----------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=test        # the frontend's Mongoose connection resolves to "test"

# --- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Pipeline tuning ---------------------------------------------------------
AUTO_FIX_CONFIDENCE=0.95      # only fixes at or above this confidence are automatic
MAX_CONCURRENT_JOBS=2
JOB_WORKER=1                  # poll the jobs collection for QUEUED work
JOB_POLL_INTERVAL=3           # seconds between polls while work is arriving
JOB_POLL_IDLE_BACKOFF=10      # seconds between polls once the queue is quiet
FREEZE_RENDERED_HTML=1        # for JS-built pages, drop scripts so fixes survive reopening
PDF_RENDER_DPI=150
PDF_MAX_PAGES=400
HTML_RENDER_TIMEOUT_MS=30000
IMAGE_FETCH_CONCURRENCY=6
DOWNLOAD_TIMEOUT=60

# --- Matching thresholds -----------------------------------------------------
TEXT_MATCH_THRESHOLD=0.75
IMAGE_MATCH_THRESHOLD=0.75
STRUCTURE_MATCH_THRESHOLD=0.80
QUESTION_MATCH_THRESHOLD=0.72
